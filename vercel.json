{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite",
            "headers": [
                {
                    "source": "/assets/(.*)",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=31536000, immutable"
                        }
                    ]
                },
                {
                    "source": "/(.*)",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=0, must-revalidate"
                        }
                    ]
                }
            ],
            "rewrites": [
                {
                    "source": "/((?!assets/).*)",
                    "destination": "/index.html"
                }
            ]
        },
        "backend": {
            "root": "backend",
            "entrypoint": "server.js"
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}